# ---- 04.1 extended simulator ---------------------------------------------
# Identical to sim_one when n_spread = 1 and default tuning (same random stream);
# n_spread > 1 splits the shock evenly over categories c01..c0k with event e01.
sim_ext <- function(M_reg, litig, comp_shift, seed, n_spread = 1, rb_only = FALSE,
                    z = 3, win = 13, trim = 0.30, C = 15, E = 12, Tm = 120, Tpre = 96, n_sig = 18,
                    pool_method = "DL", align = "center",                   # pool_method "HK" step05, "PM" and align step10
                    sev_shift = 1, shock_mult = 1,                          # step11: serious-event enrichment, larger shocks
                    shock_rr = 1, shock_len = 6) {                          # step12: true RR of the shocked pair, burst length
  set.seed(seed)
  norm <- function(x) x / sum(x)
  piD <- norm(rgamma(C, 1.5)); piIpre <- norm(piD * exp(rnorm(C, 0, .5)))
  piIpost <- if (comp_shift) norm(piIpre * exp(rnorm(C, 0, 1))) else piIpre
  phiD <- norm(rgamma(E, 1.5)); phiI <- norm(phiD * exp(rnorm(E, 0, .7)))
  shocked <- seq_len(n_spread)                                          # pairs (c01..c0k, e01): never true signals
  RR <- matrix(1, C, E); cand <- setdiff(seq_len(C * E), shocked)
  sig <- sample(cand, n_sig); RR[sig] <- sample(c(1.5, 2, 3), n_sig, replace = TRUE)
  if (shock_rr != 1) RR[shocked] <- shock_rr                            # step12: shocked pair is also a true signal (no extra draws)
  Pk <- function(phi) { X <- sweep(RR, 2, phi, "*"); X / rowSums(X) }
  PD <- Pk(phiD); PI <- Pk(phiI)
  PIpost <- if (sev_shift != 1) Pk(phiI * rep(c(1, sev_shift), c(E - 4, 4))) else PI   # step11: last 4 event groups = serious
  cats <- sprintf("c%02d", seq_len(C)); evs <- sprintf("e%02d", seq_len(E))
  mk <- function(k, r, tt, lam, pic, P) {
    mu <- as.vector(lam * pic * P)
    n <- rpois(length(mu) * length(tt), rep(mu, length(tt)))
    data.table(cat = rep(rep(cats, E), length(tt)), ev = rep(rep(evs, each = C), length(tt)),
               k = k, r = r, t = rep(tt, each = C * E), n = n, litig = FALSE)[n > 0]
  }
  pre <- seq_len(Tpre); post <- (Tpre + 1):Tm
  cnt <- rbind(mk("Direct", "pre", pre, 60, piD, PD), mk("Direct", "post", post, 30, piD, PD),
               mk("Industry", "pre", pre, 8, piIpre, PI), mk("Industry", "post", post, 8 * M_reg, piIpost, PIpost))
  shock <- function(tt, lam, k) rbindlist(lapply(shocked, function(i)   # shock rows, mean lam per month in total
    data.table(cat = cats[i], ev = "e01", k = k, r = ifelse(tt <= Tpre, "pre", "post"), t = tt,
               n = rpois(length(tt), lam * shock_mult / n_spread), litig = TRUE)))
  if (litig == "burst")     cnt <- rbind(cnt, shock(70:(69 + shock_len), 2500, "Industry"))
  if (litig == "notoriety") cnt <- rbind(cnt, shock(70:(69 + shock_len), 250, "Direct"))
  if (litig == "sustained") cnt <- rbind(cnt, shock(40:Tm, 250, "Industry"))
  cnt <- cnt[, .(n = sum(n)), by = .(cat, ev, k, r, t, litig)]
  am <- list(pre = pre, post = post)
  truth <- as.vector(RR > 1); isshock <- seq_len(C * E) %in% shocked
  res <- run_methods(cnt, cats, evs, am, z = z, win = win, trim = trim, rb_only = rb_only, pool_method = pool_method, align = align)
  if (rb_only) {
    stat <- list(rb = res$rb$low); flag <- list(rb = res$rb$f)
  } else {
    orc <- crude_methods(mat_of(cnt[litig == FALSE], cats, evs))
    stat <- list(prr = log(pmax(res$cr$prr, 1e-9)), ror = res$cr$ror_low, ic = res$cr$ic025, mh = res$mh$low,
                 sub = res$sg_low, rb = res$rb$low, oracle = orc$ror_low)
    flag <- list(prr = res$cr$f_prr, ror = res$cr$f_ror, ic = res$cr$f_ic, mh = res$mh$f, sub = res$sg_f,
                 rb = res$rb$f, oracle = orc$f_ror)
  }
  auc <- function(s) { s <- as.vector(s); s[!is.finite(s)] <- -1e6; s <- s[!isshock]; y <- truth[!isshock]
    rk <- rank(s); n1 <- sum(y); n0 <- sum(!y); (sum(rk[y]) - n1 * (n1 + 1) / 2) / (n1 * n0) }
  rbindlist(lapply(names(flag), function(m) {
    f <- as.vector(flag[[m]]); f[is.na(f)] <- FALSE
    data.table(method = m, power = mean(f[truth & !isshock]), fpr = mean(f[!truth & !isshock]),
               lit_flag = mean(f[isshock]), auc = auc(stat[[m]]),
               shock_share = sum(cnt[litig == TRUE, n]) / sum(cnt$n))   # step11: share of shocked reports in the database
  }))
}

