# ---- 02.1 basic 2x2 statistics from a category x event matrix ---------
tab2 <- function(M, rt = NULL) {                                       # all 2x2 cells; rt = reports per category (report level, step11)
  a  <- M; ne <- colSums(M)
  if (is.null(rt)) { nc <- rowSums(M); N <- sum(M) } else { nc <- rt; N <- sum(rt) }   # mention level (main) or report level
  b  <- pmax(matrix(nc, nrow(M), ncol(M)) - a, 0)
  cc <- matrix(ne, nrow(M), ncol(M), byrow = TRUE) - a
  d  <- N - a - b - cc
  list(a = a, b = b, c = cc, d = d, N = N, nc = nc, ne = ne)
}
ror_stats <- function(a, b, cc, d) {                                   # ROR with 0.5 correction, log scale
  lr <- log((a + .5) * (d + .5) / ((b + .5) * (cc + .5)))
  se <- sqrt(1 / (a + .5) + 1 / (b + .5) + 1 / (cc + .5) + 1 / (d + .5))
  list(lor = lr, se = se, low = lr - 1.96 * se)
}
crude_methods <- function(M, rt = NULL) {                              # PRR, ROR, IC on pooled matrix
  t2 <- tab2(M, rt); a <- t2$a; b <- t2$b; cc <- t2$c; d <- t2$d; N <- t2$N
  prr  <- (a / pmax(a + b, 1e-9)) / pmax(cc / pmax(cc + d, 1e-9), 1e-9)
  chi2 <- N * pmax(abs(a * d - b * cc) - N / 2, 0)^2 / pmax((a + b) * (cc + d) * (a + cc) * (b + d), 1e-9)  # Yates
  r    <- ror_stats(a, b, cc, d)
  E    <- outer(t2$nc, t2$ne) / N
  ic   <- log2((a + .5) / (E + .5))
  ic025 <- ic - 3.3 * (a + .5)^(-0.5) - 2 * (a + .5)^(-1.5)
  list(a = a, E = E, prr = prr, chi2 = chi2, ror_low = r$low, lor = r$lor, ic025 = ic025,
       f_prr = (prr >= 2 & chi2 >= 4 & a >= 3),
       f_ror = (r$low > 0 & a >= 3),
       f_ic  = (ic025 > 0 & a >= 3))
}
mh_method <- function(Ms, rts = NULL) {                                # Mantel-Haenszel ROR over strata (RGB variance)
  R <- S <- PR <- PSQR <- QS <- 0; A <- 0
  for (i in seq_along(Ms)) {
    M <- Ms[[i]]
    t2 <- tab2(M, if (is.null(rts)) NULL else rts[[i]]); a <- t2$a; b <- t2$b; cc <- t2$c; d <- t2$d; N <- t2$N
    if (N <= 0) next
    r <- a * d / N; s <- b * cc / N; P <- (a + d) / N; Q <- (b + cc) / N
    R <- R + r; S <- S + s; PR <- PR + P * r; PSQR <- PSQR + (P * s + Q * r); QS <- QS + Q * s; A <- A + a
  }
  lor <- log(R / S)
  v <- PR / (2 * R^2) + PSQR / (2 * R * S) + QS / (2 * S^2)
  low <- lor - 1.96 * sqrt(v)
  low[!is.finite(low)] <- NA
  list(low = low, f = !is.na(low) & low > 0 & A >= 3)
}

# ---- 02.2 proposed method: burst weighting + background trimming + RE pooling
burst_weights <- function(cm, z = 3, win = 13, align = "center") {    # cm: cat, k, r, t, y (monthly totals, full grid)
  setorder(cm, k, r, cat, t)
  trail_med <- function(y, k) {                                         # median of up to k previous months (no future data)
    out <- numeric(length(y)); out[1] <- y[1]                           # first month: no history -> never a burst
    for (i in seq_along(y)[-1]) out[i] <- median(y[max(1, i - k):(i - 1)])
    out
  }
  if (align == "center") {
    cm[, base := {
      if (.N >= win) as.numeric(runmed(y, win, endrule = "median")) else rep(median(y), .N)
    }, by = .(k, r, cat)]                                               # robust centred baseline within regime (main)
  } else {
    cm[, base := trail_med(y, win - 1), by = .(k, r, cat)]              # trailing baseline: previous 12 months (step10)
  }
  cm[, upper := base + z * sqrt(base) + 3]                              # Poisson-type upper bound
  cm[, w := fifelse(y > upper, upper / y, 1)]                           # down-weight only excess months
  cm
}
re_pool <- function(Y, V, method = "DL") {                            # DerSimonian-Laird across columns (strata); "HK" = Hartung-Knapp
  W <- 1 / V; W[!is.finite(W)] <- 0
  sw <- rowSums(W); m <- rowSums(W > 0)
  ybar <- rowSums(W * Y, na.rm = TRUE) / sw
  Q <- rowSums(W * (Y - ybar)^2, na.rm = TRUE)
  C <- sw - rowSums(W^2) / sw
  tau2 <- pmax(0, (Q - (m - 1)) / C); tau2[m <= 1 | !is.finite(tau2)] <- 0
  if (method == "PM") {                                                # Paule-Mandel: solve generalised Q(tau2) = m - 1
    tau_pm <- vapply(seq_len(nrow(Y)), function(i) {
      ok <- W[i, ] > 0; k <- sum(ok); if (k <= 1) return(0)
      y <- Y[i, ok]; v <- V[i, ok]
      q <- function(t2) { w <- 1 / (v + t2); mu <- sum(w * y) / sum(w); sum(w * (y - mu)^2) - (k - 1) }
      if (q(0) <= 0) return(0)                                         # no excess heterogeneity
      up <- max(1, 2 * var(y)); while (q(up) > 0) up <- up * 2         # bracket the root
      tryCatch(uniroot(q, c(0, up), tol = 1e-10)$root, error = function(e) NA_real_)   # Option A: root finding
    }, numeric(1))
    tau2 <- ifelse(is.na(tau_pm), tau2, tau_pm)                         # Option B: keep DL estimate if root finding fails
  }
  Ws <- 1 / (V + tau2); Ws[W == 0] <- 0
  mu <- rowSums(Ws * Y, na.rm = TRUE) / rowSums(Ws)
  se <- sqrt(1 / rowSums(Ws))
  I2 <- pmax(0, (Q - (m - 1)) / pmax(Q, 1e-9)); I2[m <= 1] <- 0
  crit <- rep(1.96, length(mu))                                         # normal quantile (DL)
  if (method == "HK") {                                                # modified Hartung-Knapp: t quantile, scale >= 1
    qhk <- rowSums(Ws * (Y - mu)^2, na.rm = TRUE) / pmax(m - 1, 1)
    hk <- m >= 2
    se[hk] <- sqrt(pmax(1, qhk[hk]) / rowSums(Ws)[hk])
    crit[hk] <- qt(0.975, m[hk] - 1)
  }
  list(mu = mu, se = se, I2 = I2, m = m, crit = crit)
}
rb_method <- function(Ms, trim = 0.30, min_row = 3, pool_method = "DL", rts = NULL) {   # Ms: weighted strata matrices; rts: report totals (step11)
  P <- length(Ms); nr <- nrow(Ms[[1]]); nc <- ncol(Ms[[1]])
  Y <- V <- matrix(NA_real_, nr * nc, P); A <- rep(0, nr * nc)
  for (s in seq_len(P)) {
    M <- Ms[[s]]; rs <- if (is.null(rts)) rowSums(M) else rts[[s]]; tot <- sum(rs)
    if (tot <= 0) next
    dom <- rs / tot > trim                                              # dominant (masking) categories
    colbg <- colSums(M[!dom, , drop = FALSE]); totbg <- sum(rs[!dom])  # equals sum(M[!dom, ]) at mention level
    a  <- M; b <- rs - M
    own_col <- matrix(rep(!dom, nc), nr, nc) * M                        # subtract own row only if it is in background
    cc <- matrix(colbg, nr, nc, byrow = TRUE) - own_col
    tb <- totbg - (!dom) * rs
    d  <- matrix(tb, nr, nc) - cc
    r  <- ror_stats(a, b, pmax(cc, 0), pmax(d, 0))
    ok <- matrix(rs >= min_row & tb > 0, nr, nc)
    Y[, s] <- ifelse(ok, r$lor, NA); V[, s] <- ifelse(ok, r$se^2, NA)
    A <- A + as.vector(a)
  }
  pool <- tryCatch(re_pool(Y, V, method = pool_method), error = function(e) NULL)   # Option A: random effects
  if (is.null(pool)) {                                                 # Option B: fixed effect
    W <- 1 / V; W[!is.finite(W)] <- 0
    mu <- rowSums(W * Y, na.rm = TRUE) / rowSums(W)
    pool <- list(mu = mu, se = sqrt(1 / rowSums(W)), I2 = rep(NA, length(mu)), m = rowSums(W > 0), crit = rep(1.96, length(mu)))
  }
  low <- pool$mu - pool$crit * pool$se; low[!is.finite(low)] <- NA
  list(low = matrix(low, nr, nc), I2 = matrix(pool$I2, nr, nc), m = matrix(pool$m, nr, nc),
       mu = matrix(pool$mu, nr, nc), se = matrix(pool$se, nr, nc), A = matrix(A, nr, nc),   # pooled log-ROR, SE, weighted count
       f = matrix(!is.na(low) & low > 0 & A >= 3, nr, nc))
}

# ---- 02.3 run every method on a count table ---------------------------
# cnt: data.table with cat, ev, k (channel), r (regime), t (month), n, litig (logical)
mat_of <- function(x, cats, evs) {                                     # data.table -> cat x ev matrix
  M <- matrix(0, length(cats), length(evs), dimnames = list(cats, evs))
  if (nrow(x)) {
    agg <- x[, .(n = sum(n)), by = .(cat, ev)]
    M[cbind(match(agg$cat, cats), match(agg$ev, evs))] <- agg$n
  }
  M
}
rowvec_of <- function(x, cats) {                                       # data.table (cat, n) -> reports per category
  v <- setNames(numeric(length(cats)), cats)
  if (nrow(x)) { agg <- x[, .(n = sum(n)), by = cat]; v[match(agg$cat, cats)] <- agg$n }
  v
}
run_methods <- function(cnt, cats, evs, all_months, use_burst = TRUE, use_trim = TRUE,
                        z = 3, win = 13, trim = 0.30, rb_only = FALSE, pool_method = "DL",
                        align = "center", rl = NULL) {                     # defaults = main analysis; rl = report counts (step11)
  strata <- unique(cnt[, .(k, r)])
  rv <- function(x) if (is.null(rl)) NULL else rowvec_of(x, cats)       # report totals per category, or NULL (mention level)
  cr <- mh <- sg_low <- sg_f <- NULL
  if (!rb_only) {                                                      # comparators (skipped in sensitivity runs)
    # crude (pooled, unweighted)
    cr <- crude_methods(mat_of(cnt, cats, evs), rt = rv(rl))
    # MH stratified by channel x regime
    Ms <- lapply(seq_len(nrow(strata)), function(i) mat_of(cnt[k == strata$k[i] & r == strata$r[i]], cats, evs))
    Rs <- if (is.null(rl)) NULL else lapply(seq_len(nrow(strata)), function(i) rv(rl[k == strata$k[i] & r == strata$r[i]]))
    mh <- mh_method(Ms, Rs)
    # subgroup by channel (signal in any channel)
    sg <- lapply(unique(cnt$k), function(kk) crude_methods(mat_of(cnt[k == kk], cats, evs), rt = if (is.null(rl)) NULL else rv(rl[k == kk])))
    sg_low <- Reduce(pmax, lapply(sg, function(q) ifelse(q$a >= 3, q$ror_low, -Inf)))
    sg_f   <- Reduce(`|`, lapply(sg, function(q) q$f_ror))
  }
  # proposed: burst weights -> trimmed stratum RORs -> RE pooling
  cw <- copy(cnt); rw <- if (is.null(rl)) NULL else copy(rl)
  if (use_burst) {
    cm <- (if (is.null(rl)) cnt else rl)[, .(y = sum(n)), by = .(cat, k, r, t)]   # monthly mentions (main) or reports (step11)
    grid <- rbindlist(lapply(seq_len(nrow(strata)), function(i)
      CJ(cat = cats, k = strata$k[i], r = strata$r[i], t = all_months[[strata$r[i]]])))
    cm <- merge(grid, cm, by = c("cat", "k", "r", "t"), all.x = TRUE); cm[is.na(y), y := 0]
    cm <- burst_weights(cm, z = z, win = win, align = align)
    cw <- merge(cw, cm[, .(cat, k, r, t, w)], by = c("cat", "k", "r", "t"), all.x = TRUE)
    cw[is.na(w), w := 1]; cw[, n := n * w]
    if (!is.null(rw)) {                                                # same weights for the report totals
      rw <- merge(rw, cm[, .(cat, k, r, t, w)], by = c("cat", "k", "r", "t"), all.x = TRUE)
      rw[is.na(w), w := 1]; rw[, n := n * w]
    }
  } else cm <- NULL
  Mw <- lapply(seq_len(nrow(strata)), function(i) mat_of(cw[k == strata$k[i] & r == strata$r[i]], cats, evs))
  Rw <- if (is.null(rw)) NULL else lapply(seq_len(nrow(strata)), function(i) rowvec_of(rw[k == strata$k[i] & r == strata$r[i]], cats))
  rb <- rb_method(Mw, trim = if (use_trim) trim else 1.01, pool_method = pool_method, rts = Rw)
  list(cr = cr, mh = mh, sg_low = sg_low, sg_f = sg_f, rb = rb, bursts = cm)
}

# ---- 02.3b EBGM (DuMouchel gamma-Poisson shrinker, 2-gamma mixture prior) --------
gps_fit <- function(N, E) {                                            # DuMouchel 2-gamma GPS by maximum likelihood
  ldnb <- function(N, E, a, b) lgamma(a + N) - lgamma(a) - lgamma(N + 1) - N * log1p(b / E) - a * log1p(E / b)
  nll <- function(th) { a1 <- exp(th[1]); b1 <- exp(th[2]); a2 <- exp(th[3]); b2 <- exp(th[4]); p <- plogis(th[5])
    l1 <- log(p) + ldnb(N, E, a1, b1); l2 <- log1p(-p) + ldnb(N, E, a2, b2)
    m <- pmax(l1, l2); -sum(m + log(exp(l1 - m) + exp(l2 - m))) }
  starts <- list(c(.2, .1, 2, 4, 1/3), c(.1, .1, 10, 10, .2), c(.3, .5, 6, 6, .5))
  fits <- lapply(starts, function(s) tryCatch(optim(c(log(s[1:4]), qlogis(s[5])), nll, method = "Nelder-Mead",
                                                   control = list(maxit = 5000)), error = function(e) NULL))
  fits <- Filter(Negate(is.null), fits); best <- fits[[which.min(sapply(fits, `[[`, "value"))]]
  th <- best$par; c(a1 = exp(th[1]), b1 = exp(th[2]), a2 = exp(th[3]), b2 = exp(th[4]), p = plogis(th[5]))
}
gps_scores <- function(N, E, h) {
  ldnb <- function(N, E, a, b) lgamma(a + N) - lgamma(a) - lgamma(N + 1) - N * log1p(b / E) - a * log1p(E / b)
  l1 <- log(h["p"]) + ldnb(N, E, h["a1"], h["b1"]); l2 <- log1p(-h["p"]) + ldnb(N, E, h["a2"], h["b2"])
  Q <- 1 / (1 + exp(l2 - l1))
  ebgm <- exp(Q * (digamma(h["a1"] + N) - log(h["b1"] + E)) + (1 - Q) * (digamma(h["a2"] + N) - log(h["b2"] + E)))
  eb05 <- mapply(function(n, e, q) {
    f <- function(x) q * pgamma(x, h["a1"] + n, h["b1"] + e) + (1 - q) * pgamma(x, h["a2"] + n, h["b2"] + e) - 0.05
    uniroot(f, c(1e-12, 1e4), tol = 1e-10)$root }, N, E, Q)
  list(ebgm = as.numeric(ebgm), eb05 = as.numeric(eb05))
}

