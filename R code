assign_ev <- function(pt) {                                            # vectorised first-match event group
  x <- tolower(clean_utf8(pt)); out <- rep("other", length(x)); done <- rep(FALSE, length(x))
  for (i in seq_along(ev_rules)) {                                     # rules in order
    hit <- !done & grepl(ev_rules[[i]], x, perl = TRUE)
    out[hit] <- names(ev_rules)[i]; done <- done | hit
  }
  out
}

