# ---- 05.5 simulation: Hartung-Knapp and overdispersed multi-event data -------
# sim_real: category-month totals are negative binomial (gamma frailty, size theta), events split multinomially;
# 39% of reports carry a second event group (mean 1.39 groups per report), as in the observed data.
sim_real <- function(M_reg, litig, seed, theta = 2, p2 = 0.39, C = 15, E = 12, Tm = 120, Tpre = 96, n_sig = 18) {
  set.seed(seed)
  norm <- function(x) x / sum(x)
  piD <- norm(rgamma(C, 1.5)); piI <- norm(piD * exp(rnorm(C, 0, .5)))
  phiD <- norm(rgamma(E, 1.5)); phiI <- norm(phiD * exp(rnorm(E, 0, .7)))
  RR <- matrix(1, C, E); cand <- setdiff(seq_len(C * E), 1)
  sig <- sample(cand, n_sig); RR[sig] <- sample(c(1.5, 2, 3), n_sig, replace = TRUE)
  Pk <- function(phi) { X <- sweep(RR, 2, phi, "*"); X / rowSums(X) }
  PD <- Pk(phiD); PI <- Pk(phiI)
  cats <- sprintf("c%02d", seq_len(C)); evs <- sprintf("e%02d", seq_len(E))
  mk <- function(k, r, tt, lam, pic, P) {                               # one stratum: reports -> event-group counts
    tot <- matrix(rnbinom(C * length(tt), size = theta, mu = rep(lam * pic, length(tt))), C)   # C x months
    sec <- matrix(rbinom(length(tot), tot, p2), C)                       # reports with a second event group
    out <- vector("list", length(tt))
    for (j in seq_along(tt)) {
      cnt <- matrix(0, C, E)
      for (c in which(tot[, j] > 0)) {
        cnt[c, ] <- rmultinom(1, tot[c, j], P[c, ])[, 1] + if (sec[c, j] > 0) rmultinom(1, sec[c, j], P[c, ])[, 1] else 0
      }
      nz <- which(cnt > 0)
      if (!length(nz)) next                                              # month without reports
      out[[j]] <- data.table(cat = cats[(nz - 1) %% C + 1], ev = evs[(nz - 1) %/% C + 1], k = k, r = r, t = tt[j], n = cnt[nz], litig = FALSE)
    }
    rbindlist(out)
  }
  pre <- seq_len(Tpre); post <- (Tpre + 1):Tm
  cnt <- rbind(mk("Direct", "pre", pre, 60, piD, PD), mk("Direct", "post", post, 30, piD, PD),
               mk("Industry", "pre", pre, 8, piI, PI), mk("Industry", "post", post, 8 * M_reg, piI, PI))
  shock <- function(tt, lam, k) data.table(cat = "c01", ev = "e01", k = k, r = ifelse(tt <= Tpre, "pre", "post"), t = tt,
                                          n = rnbinom(length(tt), size = theta, mu = lam), litig = TRUE)
  if (litig == "burst")     cnt <- rbind(cnt, shock(70:75, 2500, "Industry"))
  if (litig == "notoriety") cnt <- rbind(cnt, shock(70:75, 250, "Direct"))
  if (litig == "sustained") cnt <- rbind(cnt, shock(40:Tm, 250, "Industry"))
  cnt <- cnt[, .(n = sum(n)), by = .(cat, ev, k, r, t, litig)]
  am <- list(pre = pre, post = post)
  res <- run_methods(cnt, cats, evs, am)
  orc <- crude_methods(mat_of(cnt[litig == FALSE], cats, evs))
  truth <- as.vector(RR > 1); isshock <- seq_len(C * E) == 1
  stat <- list(prr = log(pmax(res$cr$prr, 1e-9)), ror = res$cr$ror_low, ic = res$cr$ic025, mh = res$mh$low,
               sub = res$sg_low, rb = res$rb$low, oracle = orc$ror_low)
  flag <- list(prr = res$cr$f_prr, ror = res$cr$f_ror, ic = res$cr$f_ic, mh = res$mh$f, sub = res$sg_f,
               rb = res$rb$f, oracle = orc$f_ror)
  auc <- function(s) { s <- as.vector(s); s[!is.finite(s)] <- -1e6; s <- s[!isshock]; y <- truth[!isshock]
    rk <- rank(s); n1 <- sum(y); n0 <- sum(!y); (sum(rk[y]) - n1 * (n1 + 1) / 2) / (n1 * n0) }
  rbindlist(lapply(names(flag), function(m) {
    f <- as.vector(flag[[m]]); f[is.na(f)] <- FALSE
    data.table(method = m, power = mean(f[truth]), fpr = mean(f[!truth & !isshock]), lit_flag = mean(f[isshock]), auc = auc(stat[[m]]))
  }))
}
