# ---- 09.2 selective shock: true signals inside the shocked category -----------
# Same generator as sim_ext (n_spread = 1); the only change is that two of the 18 true
# signals are placed in category c01 (events e02, e03), the category carrying the shock (c01, e01).
sim_sel <- function(M_reg, litig, comp_shift, seed, n_in = 2, C = 15, E = 12, Tm = 120, Tpre = 96, n_sig = 18) {
  set.seed(seed)
  norm <- function(x) x / sum(x)
  piD <- norm(rgamma(C, 1.5)); piIpre <- norm(piD * exp(rnorm(C, 0, .5)))
  piIpost <- if (comp_shift) norm(piIpre * exp(rnorm(C, 0, 1))) else piIpre
  phiD <- norm(rgamma(E, 1.5)); phiI <- norm(phiD * exp(rnorm(E, 0, .7)))
  shocked <- 1L                                                         # pair (c01, e01), never a true signal
  forced <- 1L + C * seq_len(n_in)                                      # pairs (c01, e02), (c01, e03)
  RR <- matrix(1, C, E); cand <- setdiff(seq_len(C * E), c(shocked, forced))
  sig <- c(forced, sample(cand, n_sig - n_in)); RR[sig] <- sample(c(1.5, 2, 3), n_sig, replace = TRUE)
  Pk <- function(phi) { X <- sweep(RR, 2, phi, "*"); X / rowSums(X) }
  PD <- Pk(phiD); PI <- Pk(phiI)
  cats <- sprintf("c%02d", seq_len(C)); evs <- sprintf("e%02d", seq_len(E))
  mk <- function(k, r, tt, lam, pic, P) {                               # Poisson counts for one stratum
    mu <- as.vector(lam * pic * P)
    n <- rpois(length(mu) * length(tt), rep(mu, length(tt)))
    data.table(cat = rep(rep(cats, E), length(tt)), ev = rep(rep(evs, each = C), length(tt)),
               k = k, r = r, t = rep(tt, each = C * E), n = n, litig = FALSE)[n > 0]
  }
  pre <- seq_len(Tpre); post <- (Tpre + 1):Tm
  cnt <- rbind(mk("Direct", "pre", pre, 60, piD, PD), mk("Direct", "post", post, 30, piD, PD),
               mk("Industry", "pre", pre, 8, piIpre, PI), mk("Industry", "post", post, 8 * M_reg, piIpost, PI))
  shock <- function(tt, lam, k) data.table(cat = "c01", ev = "e01", k = k, r = ifelse(tt <= Tpre, "pre", "post"),
                                           t = tt, n = rpois(length(tt), lam), litig = TRUE)
  if (litig == "burst")     cnt <- rbind(cnt, shock(70:75, 2500, "Industry"))
  if (litig == "notoriety") cnt <- rbind(cnt, shock(70:75, 250, "Direct"))
  if (litig == "sustained") cnt <- rbind(cnt, shock(40:Tm, 250, "Industry"))
  cnt <- cnt[, .(n = sum(n)), by = .(cat, ev, k, r, t, litig)]
  truth <- as.vector(RR > 1); isshock <- seq_len(C * E) %in% shocked; isin <- seq_len(C * E) %in% forced
  res <- run_methods(cnt, cats, evs, list(pre = pre, post = post))
  orc <- crude_methods(mat_of(cnt[litig == FALSE], cats, evs))
  flag <- list(prr = res$cr$f_prr, ror = res$cr$f_ror, ic = res$cr$f_ic, mh = res$mh$f, sub = res$sg_f,
               rb = res$rb$f, oracle = orc$f_ror)
  rbindlist(lapply(names(flag), function(m) {
    f <- as.vector(flag[[m]]); f[is.na(f)] <- FALSE
    data.table(method = m, power_in_shocked_cat = mean(f[isin]), power_other = mean(f[truth & !isin]),
               fpr = mean(f[!truth & !isshock]), lit_flag = mean(f[isshock]))
  }))
}
