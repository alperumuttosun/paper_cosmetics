# ---- 02.5 Monte Carlo ---------------------------------------------------
sim_one <- function(M_reg, litig, comp_shift, seed, C = 15, E = 12, Tm = 120, Tpre = 96, n_sig = 18) {
  set.seed(seed)
  norm <- function(x) x / sum(x)
  piD <- norm(rgamma(C, 1.5)); piIpre <- norm(piD * exp(rnorm(C, 0, .5)))
  piIpost <- if (comp_shift) norm(piIpre * exp(rnorm(C, 0, 1))) else piIpre
  phiD <- norm(rgamma(E, 1.5)); phiI <- norm(phiD * exp(rnorm(E, 0, .7)))   # channel-specific event coding
  RR <- matrix(1, C, E); cand <- setdiff(seq_len(C * E), 1)                 # pair (1,1) = litigated pair, no true signal
  sig <- sample(cand, n_sig); RR[sig] <- sample(c(1.5, 2, 3), n_sig, replace = TRUE)
  Pk <- function(phi) { X <- sweep(RR, 2, phi, "*"); X / rowSums(X) }
  PD <- Pk(phiD); PI <- Pk(phiI)
  cats <- sprintf("c%02d", seq_len(C)); evs <- sprintf("e%02d", seq_len(E))
  mk <- function(k, r, tt, lam, pic, P) {                                # Poisson counts for one stratum
    mu <- as.vector(lam * pic * P)                                       # C x E means per month
    n <- rpois(length(mu) * length(tt), rep(mu, length(tt)))
    data.table(cat = rep(rep(cats, E), length(tt)), ev = rep(rep(evs, each = C), length(tt)),
               k = k, r = r, t = rep(tt, each = C * E), n = n, litig = FALSE)[n > 0]
  }
  pre <- seq_len(Tpre); post <- (Tpre + 1):Tm
  cnt <- rbind(mk("Direct", "pre", pre, 60, piD, PD), mk("Direct", "post", post, 30, piD, PD),
               mk("Industry", "pre", pre, 8, piIpre, PI), mk("Industry", "post", post, 8 * M_reg, piIpost, PI))
  if (litig == "burst") {                                               # 6-month dump, ~15000 reports
    tt <- 70:75; cnt <- rbind(cnt, data.table(cat = "c01", ev = "e01", k = "Industry", r = "pre", t = tt, n = rpois(6, 2500), litig = TRUE))
  }
  if (litig == "notoriety") {                                           # media-driven consumer burst, ~1500 reports
    tt <- 70:75; cnt <- rbind(cnt, data.table(cat = "c01", ev = "e01", k = "Direct", r = "pre", t = tt, n = rpois(6, 250), litig = TRUE))
  }
  if (litig == "sustained") {                                           # long-running stream, ~250/month
    tt <- 40:Tm; cnt <- rbind(cnt, data.table(cat = "c01", ev = "e01", k = "Industry", r = ifelse(tt <= Tpre, "pre", "post"),
                                              t = tt, n = rpois(length(tt), 250), litig = TRUE))
  }
  cnt <- cnt[, .(n = sum(n)), by = .(cat, ev, k, r, t, litig)]
  am <- list(pre = pre, post = post)
  res <- run_methods(cnt, cats, evs, am)
  res0 <- run_methods(cnt, cats, evs, am, use_burst = FALSE)
  res1 <- run_methods(cnt, cats, evs, am, use_trim = FALSE)
  orc <- crude_methods(mat_of(cnt[litig == FALSE], cats, evs))
  truth <- as.vector(RR > 1); litpair <- seq_len(C * E) == 1
  stat <- list(prr = log(pmax(res$cr$prr, 1e-9)), ror = res$cr$ror_low, ic = res$cr$ic025, mh = res$mh$low,
               sub = res$sg_low, rb = res$rb$low, rb_noburst = res0$rb$low, rb_notrim = res1$rb$low, oracle = orc$ror_low)
  flag <- list(prr = res$cr$f_prr, ror = res$cr$f_ror, ic = res$cr$f_ic, mh = res$mh$f, sub = res$sg_f,
               rb = res$rb$f, rb_noburst = res0$rb$f, rb_notrim = res1$rb$f, oracle = orc$f_ror)
  auc <- function(s) { s <- as.vector(s); s[!is.finite(s)] <- -1e6; s <- s[!litpair]; y <- truth[!litpair]
    rk <- rank(s); n1 <- sum(y); n0 <- sum(!y); (sum(rk[y]) - n1 * (n1 + 1) / 2) / (n1 * n0) }
  rbindlist(lapply(names(flag), function(m) {
    f <- as.vector(flag[[m]]); f[is.na(f)] <- FALSE
    data.table(method = m, power = mean(f[truth]), fpr = mean(f[!truth & !litpair]),
               lit_flag = f[litpair], auc = auc(stat[[m]]))
  }))
}

if (!file.exists("step02_mc_summary.csv")) {
  R_rep <- 500                                                          # replications per scenario
  grid <- CJ(M_reg = c(1, 5, 15), litig = c("none", "burst", "sustained", "notoriety"), comp_shift = c(FALSE, TRUE))
  jobs <- grid[rep(seq_len(.N), each = R_rep)][, `:=`(rep = rep(seq_len(R_rep), nrow(grid)), seed = 20261118 + .I)]
  run_job <- function(i) {
    j <- jobs[i]
    out <- sim_one(j$M_reg, j$litig, j$comp_shift, j$seed)
    out[, `:=`(M_reg = j$M_reg, litig = j$litig, comp_shift = j$comp_shift, rep = j$rep)]
    out
  }
  t0 <- Sys.time()
  mc <- tryCatch({                                                      # Option A: parallel workers
    ncore <- max(1, parallel::detectCores() - 1)
    cl <- parallel::makeCluster(ncore)
    parallel::clusterEvalQ(cl, suppressPackageStartupMessages(library(data.table)))
    parallel::clusterExport(cl, c("jobs", "sim_one", "run_methods", "mat_of", "crude_methods", "mh_method",
                                  "rb_method", "re_pool", "burst_weights", "tab2", "ror_stats"), envir = environment())
    r <- tryCatch(rbindlist(parallel::parLapply(cl, seq_len(nrow(jobs)), run_job)),
                  finally = try(parallel::stopCluster(cl), silent = TRUE))
    r
  }, error = function(e) { cat("MC Option A (parallel) failed:", conditionMessage(e), "-> sequential\n"); NULL })
  if (is.null(mc)) mc <- rbindlist(lapply(seq_len(nrow(jobs)), run_job))   # Option B: sequential
  cat("MC time:", round(as.numeric(difftime(Sys.time(), t0, units = "mins")), 1), "min\n")
  fwrite(mc, "step02_mc_raw.csv", bom = TRUE)
  ms <- mc[, .(power = round(mean(power), 3), fpr = round(mean(fpr), 4), lit_flag_rate = round(mean(lit_flag), 3),
