clean_utf8 <- function(x) {                                            # force valid UTF-8 text
  x <- as.character(x)
  x <- iconv(x, from = "UTF-8", to = "UTF-8", sub = "")                # drop invalid bytes
  x[is.na(x)] <- ""
  enc2utf8(x)
}

get_json <- function(url, tries = 3) {                                 # safe GET for openFDA
  for (i in seq_len(tries)) {
    r <- tryCatch(httr::GET(url, httr::timeout(90)), error = function(e) NULL)
    if (!is.null(r)) {
      sc <- httr::status_code(r)
      if (sc == 200) {
        txt <- httr::content(r, as = "text", encoding = "UTF-8")
        txt <- iconv(txt, "UTF-8", "UTF-8", sub = "")
        return(jsonlite::fromJSON(txt, simplifyVector = TRUE))
      }
      if (sc == 404) return(NULL)                                      # "no match" in openFDA
    }
    Sys.sleep(2 * i)
  }
  NULL
}

g1 <- function(x, nm) {                                                # one field, arrays joined by "|"
  v <- x[[nm]]
  if (is.null(v) || length(v) == 0) return(NA_character_)
  clean_utf8(paste(unlist(v), collapse = "|"))
}

base_api <- "https://api.fda.gov/cosmetic/event.json"                  # openFDA cosmetic endpoint

# ======================================================================
# STEP 00 : data download and availability check (skipped when done)
# ======================================================================
step00_files <- c("step00_openfda_reports.csv", "step00_openfda_meta.csv",
                  "step00_api_yearly.csv", "step00_api_monthly.csv")
if (all(file.exists(step00_files))) {
  cat("step00 outputs found -> step00 skipped\n")
} else {
  status <- list(yolA = FALSE, yolB = FALSE)

  # ---- OPTION A : bulk download -----------------------------------------
  f_rep <- "step00_openfda_reports.csv"
  status$yolA <- tryCatch({
    if (!file.exists(f_rep)) {
      dl <- get_json("https://api.fda.gov/download.json")              # list of bulk files
      if (is.null(dl)) stop("download.json not reachable")
      parts <- dl$results$cosmetic$event$partitions; src <- "cosmetic/event"
      if (is.null(parts) || NROW(parts) == 0) { parts <- dl$results$food$event$partitions; src <- "food/event" }
      if (is.null(parts) || NROW(parts) == 0) stop("no bulk partitions found")
      zips <- character(0)
      for (u in parts$file) {                                          # download each zip once
        zf <- basename(u)
        if (!file.exists(zf)) download.file(u, zf, mode = "wb", quiet = TRUE)
        zips <- c(zips, zf)
      }
      read_part <- function(zf) {                                      # read one zipped JSON
        inside <- unzip(zf, list = TRUE)$Name[1]
        con <- unz(zf, inside); on.exit(close(con))
        txt <- paste(readLines(con, encoding = "UTF-8", warn = FALSE), collapse = "\n")
        txt <- iconv(txt, "UTF-8", "UTF-8", sub = "")
        jsonlite::fromJSON(txt, simplifyVector = FALSE)$results
      }
      recs <- unlist(lapply(zips, read_part), recursive = FALSE)
      samp <- recs[unique(round(seq(1, length(recs), length.out = min(5000, length(recs)))))]
      fl   <- unlist(lapply(samp, function(r) unique(gsub("[0-9]+$", "", names(unlist(r))))))
      inv  <- data.table(field = names(table(fl)), n_in_sample = as.integer(table(fl)))
      inv[, share := round(n_in_sample / length(samp), 3)]
      fwrite(inv[order(-share)], "step00_field_inventory.csv", bom = TRUE)
      flat <- rbindlist(lapply(recs, function(r) {
        pr <- if (!is.null(r$products)) r$products else r$product
        pn <- if (length(pr)) vapply(pr, function(p) g1(p, "product_name"), "") else NA_character_
        ro <- if (length(pr)) vapply(pr, function(p) g1(p, "role"), "") else NA_character_
        ind <- if (length(pr)) vapply(pr, function(p) g1(p, "industry_name"), "") else NA_character_
        pa <- r$patient; if (is.null(pa)) pa <- r$consumer
        data.table(
          report_number = g1(r, "report_number"), report_version = g1(r, "report_version"),
          legacy_report_id = g1(r, "legacy_report_id"), report_type = g1(r, "report_type"),
          initial_received_date = g1(r, "initial_received_date"),
          latest_received_date = g1(r, "latest_received_date"), event_date = g1(r, "event_date"),
          n_products = length(pr),
          product_names = clean_utf8(paste(pn, collapse = "|")),
          product_roles = clean_utf8(paste(ro, collapse = "|")),
          industry = clean_utf8(paste(unique(ind), collapse = "|")),
          reactions = g1(r, "reactions"), outcomes = g1(r, "outcomes"),
          age = if (is.null(pa)) NA_character_ else g1(pa, "age"),
          age_unit = if (is.null(pa)) NA_character_ else g1(pa, "age_unit"),
          gender = if (is.null(pa)) NA_character_ else g1(pa, "gender"))
      }), fill = TRUE)
      if (src == "food/event") flat <- flat[grepl("cosmetic", industry, ignore.case = TRUE)]
      flat[, source_endpoint := src]
      fwrite(flat, f_rep, bom = TRUE)
    }
    TRUE
  }, error = function(e) { cat("step00 Option A failed:", conditionMessage(e), "\n"); FALSE })

  # ---- OPTION B : API count queries --------------------------------------
  status$yolB <- tryCatch({
    if (!file.exists("step00_openfda_meta.csv")) {
      a <- get_json(paste0(base_api, "?sort=initial_received_date:asc&limit=1"))
      z <- get_json(paste0(base_api, "?sort=initial_received_date:desc&limit=1"))
      if (is.null(z)) stop("cosmetic/event API not reachable")
      fwrite(data.table(last_updated = z$meta$last_updated, total_reports = z$meta$results$total,
                        first_received = a$results$initial_received_date[1],
                        last_received = z$results$initial_received_date[1],
                        fields_in_latest_record = paste(unique(names(unlist(z$results))), collapse = "; ")),
             "step00_openfda_meta.csv", bom = TRUE)
    }
    if (!file.exists("step00_api_yearly.csv") || !file.exists("step00_api_monthly.csv")) {
      yrs <- 2001:as.integer(format(Sys.Date(), "%Y")); yr_rows <- list(); mo_rows <- list()
      for (y in yrs) {
        rng <- sprintf("initial_received_date:[%d0101+TO+%d1231]", y, y)
        tot <- get_json(sprintf("%s?search=%s&limit=1", base_api, rng))
        n_y <- if (is.null(tot)) 0L else as.integer(tot$meta$results$total)
        rt  <- get_json(sprintf("%s?search=%s&count=report_type.exact", base_api, rng))
        if (is.null(rt)) rt <- get_json(sprintf("%s?search=%s&count=report_type", base_api, rng))
        yr_rows[[length(yr_rows) + 1]] <- if (!is.null(rt) && length(rt$results))
          data.table(year = y, total = n_y, report_type = clean_utf8(rt$results$term), n = rt$results$count) else
          data.table(year = y, total = n_y, report_type = NA_character_, n = NA_integer_)
        if (n_y > 0) {
          dd <- get_json(sprintf("%s?search=%s&count=initial_received_date", base_api, rng))
          if (!is.null(dd) && length(dd$results))
            mo_rows[[length(mo_rows) + 1]] <- data.table(day = as.character(dd$results$time), n = dd$results$count)
        }
        Sys.sleep(0.4)
      }
      fwrite(rbindlist(yr_rows, fill = TRUE), "step00_api_yearly.csv", bom = TRUE)
      mo <- rbindlist(mo_rows)
      if (nrow(mo)) mo <- mo[, .(n = sum(n)), by = .(month = substr(day, 1, 6))][order(month)]
      fwrite(mo, "step00_api_monthly.csv", bom = TRUE)
    }
    TRUE
  }, error = function(e) { cat("step00 Option B failed:", conditionMessage(e), "\n"); FALSE })
  print(unlist(status))
}


