run_parallel <- function(jobs, fun, extra = character()) {             # Option A parallel, Option B sequential; extra = more globals to export
  t0 <- Sys.time()
  out <- tryCatch({
    ncore <- max(1, parallel::detectCores() - 1)
    cl <- parallel::makeCluster(ncore)
    parallel::clusterEvalQ(cl, suppressPackageStartupMessages(library(data.table)))
    parallel::clusterExport(cl, c("sim_ext", "run_methods", "mat_of", "rowvec_of", "crude_methods", "mh_method",
                                  "rb_method", "re_pool", "burst_weights", "tab2", "ror_stats", extra), envir = globalenv())
    parallel::clusterExport(cl, c("jobs", "fun"), envir = environment())
    r <- tryCatch(rbindlist(parallel::parLapply(cl, seq_len(nrow(jobs)), function(i) fun(jobs[i]))),
                  finally = try(parallel::stopCluster(cl), silent = TRUE))
    r
  }, error = function(e) { cat("Option A (parallel) failed:", conditionMessage(e), "-> sequential\n"); NULL })
  if (is.null(out)) out <- rbindlist(lapply(seq_len(nrow(jobs)), function(i) fun(jobs[i])))
  cat("  time:", round(as.numeric(difftime(Sys.time(), t0, units = "mins")), 1), "min\n")
  out
}

