# ======================================================================
# STEP 12 : additional robustness analyses
#   12.1 true signal in the shocked pair itself: the shocked pair (c01, e01)
#        has a true relative reporting rate of 2, and the shock is added on top
#        (4 shocks x 500; "Shocked pair flagged" = power for that pair)
#   12.2 burst duration: litigation and notoriety bursts lasting 9, 12 or 18
#        months at the same monthly intensity (2 shocks x 3 lengths x 500);
#        6 months = main simulation
# Regime multiplier 5, no composition shift, same seeds as the main Monte Carlo.
# New arguments (shock_rr, shock_len) default to the earlier design; power now
# excludes the shocked pair explicitly, which changes nothing when it is not a
# true signal (checked by the step04 reproducibility check).
# ======================================================================
cat("\n--- step12 ---\n")
sim_v12 <- function(j) {
  o <- if (j$design == "same_pair") sim_ext(j$M_reg, j$litig, j$comp_shift, j$seed, shock_rr = 2) else
    sim_ext(j$M_reg, j$litig, j$comp_shift, j$seed, shock_len = j$len)
  o[, `:=`(design = j$design, len = j$len, litig = j$litig, rep = j$rep)]; o
}
if (!file.exists("step12_sim_raw.csv")) {
  jobs <- rbind(copy(base_jobs)[, `:=`(design = "same_pair", len = 6L)],
                rbindlist(lapply(c(9L, 12L, 18L), function(L)
                  copy(base_jobs)[litig %in% c("burst", "notoriety")][, `:=`(design = "duration", len = L)])))   # 2,000 + 3,000
  cat("True signal in the shocked pair and burst duration:", nrow(jobs), "databases\n")
  fwrite(run_parallel(jobs, sim_v12, extra = "sim_v12"), "step12_sim_raw.csv", bom = TRUE)
} else cat("step12 simulation outputs found -> skipped\n")
s12 <- fread("step12_sim_raw.csv")
s12 <- rbind(s12[, .(design, len, litig, method, rep, power, fpr, lit_flag, auc, shock_share)],
             mc_raw[M_reg == 5 & comp_shift == FALSE & litig %in% c("burst", "notoriety") & method %in% main_m,
                    .(design = "duration", len = 6L, litig, method, rep, power, fpr, lit_flag, auc, shock_share = NA_real_)])  # 6 months = main
tab12 <- s12[, .(fpr = round(mean(fpr), 4), fpr_mcse = round(sd(fpr) / sqrt(.N), 4),
                 power = round(mean(power), 3), power_mcse = round(sd(power) / sqrt(.N), 4),
                 auc = round(mean(auc), 3), shocked_pair_flag = round(mean(lit_flag), 3),
                 shocked_pair_mcse = round(sd(lit_flag) / sqrt(.N), 4),
                 shock_share = round(mean(shock_share), 3), n_datasets = .N),
             by = .(design, scenario = litig, burst_months = len, method)]
tab12 <- tab12[order(match(design, c("same_pair", "duration")), match(scenario, names(litig_lab)), burst_months, match(method, main_m))]
tab12[, `:=`(scenario = litig_lab[scenario], method = meth_lab[method],
             design = fifelse(design == "same_pair", "True signal (RR 2) in the shocked pair", "Burst duration"))]
print(tab12[method %in% c("ROR", "MH-ROR", "RB (proposed)", "Oracle ROR")])
fwrite(tab12, "step12_table_same_pair_duration.csv", bom = TRUE)
