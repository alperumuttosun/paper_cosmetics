assign_cat <- function(x) {                                            # vectorised first-match category
  x <- tolower(clean_utf8(x))
  x <- gsub("fragrance[- ]free", "", x)                                # "fragrance free" is not a fragrance
  out <- rep("other", length(x)); done <- rep(FALSE, length(x))
  for (i in seq_along(cat_rules)) {                                    # rules in order; a label can appear twice
    hit <- !done & grepl(cat_rules[[i]], x, perl = TRUE)
    out[hit] <- names(cat_rules)[i]; done <- done | hit
  }
  out
}

